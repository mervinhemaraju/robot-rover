# clangd config (editor IntelliSense only; does not affect the Arduino build).
#
# Include paths and defines come from build/compile_commands.json, generated by
# ./gen-compile-db.sh (git-ignored). Re-run that script after adding a source
# file, changing #includes, or upgrading the Renesas core.
#
# The tweaks below adapt the arm-none-eabi build command to clangd's host clang:
#   Compiler              : use host clang++ instead of the cross-compiler
#   Add -xc++             : parse the .ino as C++ (clangd does not know the ext)
#   Add -include Arduino.h: give the bare .ino the implicit core include
#   Remove -m*            : drop ARM flags host clang rejects
CompileFlags:
  CompilationDatabase: build
  Compiler: clang++
  Add: [-xc++, -include, Arduino.h]
  Remove: [-mcpu=*, -mfpu=*, -mfloat-abi=*, -mthumb, -mabi=*]
